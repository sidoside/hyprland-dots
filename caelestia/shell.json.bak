{
    "appearance": {
        "transparency": {
            "enabled": true
        }
    },
    "background": {
        "desktopClock": {
            "enabled": true,
            "position": "middle-center"
        }
    },
    "bar": {
        "activeWindow": {
            "compact": true,
            "inverted": true
        },
        "clock": {
            "background": true,
            "showDate": true
        },
        "persistent": false,
        "tray": {
            "background": true,
            "compact": true,
            "recolour": true
        },
        "workspaces": {
            "activeTrail": true,
            "maxWindowIcons": 5,
            "occupiedBg": false,
            "shown": 5
        }
    },
    "launcher": {
        "useFuzzy": {
            "actions": true,
            "apps": true,
            "schemes": true,
            "variants": true,
            "wallpapers": true
        },
        "vimKeybinds": true
    },
    "services": {
        "audioIncrement": 0.01,
        "brightnessIncrement": 0.01,
        "useFahrenheit": false
    },
    "sidebar": {
        "enabled": true
    },
    "utilities": {
